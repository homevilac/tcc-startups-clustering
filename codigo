import warnings
warnings.filterwarnings('ignore')

import numpy as np
import pandas as pd
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt

from sklearn.preprocessing import StandardScaler, MinMaxScaler
from sklearn.decomposition import PCA
from sklearn.cluster import KMeans, AgglomerativeClustering
from sklearn.metrics import silhouette_score, silhouette_samples, adjusted_rand_score
from scipy.cluster.hierarchy import dendrogram, linkage
from scipy.spatial.distance import cdist
from scipy.stats import chi2_contingency
from scipy.optimize import linear_sum_assignment
from itertools import permutations

np.random.seed(42)

COR_PT = '#1a5276'
COR_BR = '#c0392b'
CORES_CLUSTER = ['#2980b9', '#c0392b', '#27ae60', '#8e44ad']

plt.rcParams.update({
    'font.size': 11, 'axes.titlesize': 11, 'axes.labelsize': 11, 'figure.dpi': 180,
    'axes.spines.top': False, 'axes.spines.right': False,
})

# ═════════════════════════════════════════════════════════
# PASSO 1 -- CARGA E SEPARAÇÃO DOS DADOS
# ═════════════════════════════════════════════════════════
df = pd.read_excel('Dados MBA.xlsx', sheet_name='Base Final')
df.columns = [c.replace('NegÃ³cio', 'Negócio') for c in df.columns]

# CORREÇÃO: a empresa "Meight" (Portugal) aparecia duplicada na base -- as duas
# linhas são idênticas em todas as variáveis usadas no modelo. Removida a
# duplicata, mantendo uma única ocorrência por empresa/país.
n_antes = len(df)
df = df.drop_duplicates(subset=['Empresa', 'País'], keep='first').reset_index(drop=True)
print(f" -> Duplicatas removidas: {n_antes - len(df)} ({n_antes} -> {len(df)} empresas)")

pt = df[df['País'] == 'Portugal'].copy().reset_index(drop=True)
br = df[df['País'] == 'Brasil'].copy().reset_index(drop=True)
print(f" -> Portugal: {len(pt)} | Brasil: {len(br)} | Total: {len(df)}")

NUM_FEATURES = [
    'Captação per HC',
    'Intensidade Histórica (Total Captado/Anos de fundação)',
    'Momentum (%ult aporte/total captado)',
    'Score Deeptech',
    'Score Analytics',
]
IH_COL = NUM_FEATURES[1]

EXCEL_ERRORS = ['#DIV/0!', '#N/A', '#VALUE!', '#REF!', '#NAME?', '#NULL!', '#NUM!']
for col in NUM_FEATURES:
    pt[col] = pd.to_numeric(pt[col].replace(EXCEL_ERRORS, np.nan), errors='coerce')
    br[col] = pd.to_numeric(br[col].replace(EXCEL_ERRORS, np.nan), errors='coerce')

# CORREÇÃO: a coluna "Captação per HC" original misturava dois critérios --
# para 147 das 235 empresas (63%), o valor usava o ponto médio da faixa de
# headcount em vez do número real de funcionários. Recalcula-se aqui de forma
# homogênea para toda a amostra, usando sempre o número real de funcionários
# (coluna "Funcionários", sem valores ausentes ou <= 0).
pt['Captação per HC'] = pt['Total Captado (USD)'] / pt['Funcionários']
br['Captação per HC'] = br['Total Captado (USD)'] / br['Funcionários']

# Intensidade Histórica negativa é erro de dado (razão Total Captado/Idade, ambos >= 0)
n_neg_pt = int((pt[IH_COL] < 0).sum())
n_neg_br = int((br[IH_COL] < 0).sum())
pt.loc[pt[IH_COL] < 0, IH_COL] = np.nan
br.loc[br[IH_COL] < 0, IH_COL] = np.nan
print(f" -> Intensidade Histórica negativa tratada como ausente: {n_neg_pt} PT, {n_neg_br} BR")

# CORREÇÃO: empresas cuja Data do Último Financiamento antecede a Fundação
# declarada têm Idade (e, por consequência, Intensidade Histórica) logicamente
# inválida. Identificadas: Nonius (PT) e Zenvia (BR). Tratadas como ausentes,
# sujeitas à mesma imputação por mediana das demais.
for base in (pt, br):
    fund = pd.to_numeric(base['Fundação'], errors='coerce')
    ult_finan = pd.to_datetime(base['Data Últ. Finan.'], errors='coerce')
    inconsistente = ult_finan.dt.year < fund
    if inconsistente.sum() > 0:
        print(f"    Datas inconsistentes (Fundação > Data Últ. Finan.): "
              f"{base.loc[inconsistente, 'Empresa'].tolist()}")
    base.loc[inconsistente, IH_COL] = np.nan

pt[NUM_FEATURES] = pt[NUM_FEATURES].fillna(pt[NUM_FEATURES].median())
br[NUM_FEATURES] = br[NUM_FEATURES].fillna(br[NUM_FEATURES].median())

# ═════════════════════════════════════════════════════════
# PASSO 2 -- TRANSFORMAÇÃO LOG (SEM OHE DE MODELO DE NEGÓCIO)
# ═════════════════════════════════════════════════════════
LOG_COLS = ['Captação per HC', IH_COL]
for c in LOG_COLS:
    pt[c] = np.log1p(pt[c])
    br[c] = np.log1p(br[c])

pt_full = pt[NUM_FEATURES].reset_index(drop=True)
br_full = br[NUM_FEATURES].reset_index(drop=True)
print(f" -> Features utilizadas ({len(NUM_FEATURES)}): {NUM_FEATURES}")


# ═════════════════════════════════════════════════════════
# CORRELAÇÃO DE PEARSON ENTRE AS 5 VARIÁVEIS DO MODELO
# ═════════════════════════════════════════════════════════
from scipy.stats import pearsonr

print("\nMatriz de correlação de Pearson (pós-log, pré-padronização):")
print(pt[NUM_FEATURES].corr(method='pearson').round(3))

print("\nSignificância de cada par:")
for i, c1 in enumerate(NUM_FEATURES):
    for c2 in NUM_FEATURES[i+1:]:
        r, p = pearsonr(pt[c1], pt[c2])
        sig = "***" if p < 0.001 else "**" if p < 0.01 else "*" if p < 0.05 else "ns"
        print(f"  {c1} x {c2}: r={r:+.3f}, p={p:.4f} {sig}")
# Resultado: Cap/HC x Int.Hist. (r=0,728***) já discutido nos loadings de PC1.
# Momentum x Cap/HC (r=-0,355***) e Momentum x Int.Hist. (r=-0,399***) --
# ambos significativos, sustentam a composição de PC1 (Momentum carrega
# negativamente, Cap/HC e Int.Hist. carregam positivamente). Scores Deeptech
# e Analytics não correlacionam significativamente com nenhuma outra
# variável (p>0,05 em todos os pares), consistente com PC2 como eixo
# independente de perfil tecnológico.


# ═════════════════════════════════════════════════════════
# PASSO 3 -- PADRONIZAÇÃO Z-SCORE
# ═════════════════════════════════════════════════════════
scaler = StandardScaler()
pt_scaled = scaler.fit_transform(pt_full)
br_scaled = scaler.transform(br_full)

# ═════════════════════════════════════════════════════════
# PASSO 4 -- PCA
# ═════════════════════════════════════════════════════════
pca_diag = PCA(n_components=None, random_state=42)
pca_diag.fit(pt_scaled)
var_cumul = np.cumsum(pca_diag.explained_variance_ratio_)
n_comp = int(np.argmax(var_cumul >= 0.80) + 1)

pca = PCA(n_components=n_comp, random_state=42)
pt_pca = pca.fit_transform(pt_scaled)
br_pca = pca.transform(br_scaled)
print(f" -> Componentes retidos: {n_comp} | Variância acumulada: {var_cumul[n_comp-1]*100:.1f}%")
for i, ev in enumerate(pca.explained_variance_ratio_):
    print(f"    PC{i+1}: {ev*100:.1f}%")

# ═════════════════════════════════════════════════════════
# PASSO 5 -- SELEÇÃO DE K (ELBOW + SILHUETA)
# ═════════════════════════════════════════════════════════
inertias, silhouettes = [], []
K_RANGE = range(2, 9)
for k in K_RANGE:
    km = KMeans(n_clusters=k, random_state=42, n_init=20)
    lbl = km.fit_predict(pt_pca)
    inertias.append(km.inertia_)
    silhouettes.append(float(silhouette_score(pt_pca, lbl)))
    print(f"    k={k} | Inércia={km.inertia_:>10.1f} | Silhueta={silhouettes[-1]:.4f}")

# No intervalo testado, a Silhueta não apresenta máximo interior nítido
# (cresce até a borda k=8); o critério decisivo passa a ser o método Elbow --
# o ponto de maior desaceleração na queda marginal de inércia (maior "quebra"
# na taxa de melhoria, não a maior queda absoluta, que ocorre trivialmente
# entre os primeiros valores de k).
K_LIST = list(K_RANGE)
deltas = np.array([inertias[i] - inertias[i+1] for i in range(len(inertias)-1)])
decel = deltas[:-1] - deltas[1:]
best_decel_idx = int(np.argmax(decel))
best_k = K_LIST[best_decel_idx + 1]
print(f" -> k ótimo (cotovelo do método Elbow): {best_k} (Silhueta={silhouettes[K_LIST.index(best_k)]:.4f})")

# ═════════════════════════════════════════════════════════
# PASSO 6 -- K-MEANS FINAL
# ═════════════════════════════════════════════════════════
km_final = KMeans(n_clusters=best_k, random_state=42, n_init=20)
pt['Cluster'] = km_final.fit_predict(pt_pca)
centroids = km_final.cluster_centers_

# Nomes atribuídos dinamicamente por característica dominante, não por índice
# fixo do K-Means (que é arbitrário e pode mudar a cada novo ajuste do modelo).
cstats_naming = pt.groupby('Cluster')[NUM_FEATURES].mean()
restantes = list(cstats_naming.index)
NOMES_MANUAIS = {}

c_intensiva = cstats_naming.loc[restantes, 'Captação per HC'].idxmax()
NOMES_MANUAIS[c_intensiva] = 'Captação Intensiva'
restantes.remove(c_intensiva)

c_deeptech = cstats_naming.loc[restantes, 'Score Deeptech'].idxmax()
NOMES_MANUAIS[c_deeptech] = 'Perfil Deeptech'
restantes.remove(c_deeptech)

c_enxuto = cstats_naming.loc[restantes, 'Captação per HC'].idxmin()
NOMES_MANUAIS[c_enxuto] = 'Early Stage Enxuto'
restantes.remove(c_enxuto)

for c in restantes:
    NOMES_MANUAIS[c] = 'Crescimento Tradicional'

NOMES = {c: f"C{i+1} – {NOMES_MANUAIS[c]}" for i, c in enumerate(sorted(NOMES_MANUAIS))}
for c, n in NOMES.items():
    print(f"    {n}: {int((pt['Cluster']==c).sum())} empresas PT")

# ═════════════════════════════════════════════════════════
# PASSO 7 -- CLUSTERING HIERÁRQUICO (validação)
# ═════════════════════════════════════════════════════════
Z_linkage = linkage(pt_pca, method='ward')
hier_labels = AgglomerativeClustering(n_clusters=best_k, linkage='ward').fit_predict(pt_pca)
best_acc = 0.0
for perm in permutations(range(best_k)):
    mapped = np.array([perm[l] for l in hier_labels])
    acc = float(np.mean(mapped == pt['Cluster'].values))
    best_acc = max(best_acc, acc)
print(f" -> Concordância K-Means x Hierárquico: {best_acc*100:.1f}%")

cstats = pt.groupby('Cluster')[NUM_FEATURES].mean()
print(cstats.round(3))

# ═════════════════════════════════════════════════════════
# PASSO 8 -- FIGURAS (1 a 6)
# ═════════════════════════════════════════════════════════
labels_pt = pt['Cluster'].values.astype(int)

fig, axes = plt.subplots(1, 3, figsize=(14, 4.2))
ax = axes[0]
ax.plot(range(1, len(var_cumul)+1), var_cumul*100, 'o-', color=COR_PT, lw=2, markersize=5)
ax.axhline(80, color='#e74c3c', ls='--', lw=1.2, label='Limiar 80%')
ax.axvline(n_comp, color='#7f8c8d', ls=':', lw=1.3)
ax.fill_between(range(1, n_comp+1), var_cumul[:n_comp]*100, alpha=0.12, color=COR_PT)
ax.set_xlabel('Componentes'); ax.set_ylabel('Variância Acumulada (%)')
ax.legend(fontsize=11); ax.grid(False)
ax = axes[1]
ax.plot(K_RANGE, inertias, 'o-', color=COR_PT, lw=2, markersize=5)
ax.axvline(best_k, color='#e74c3c', ls='--', lw=1.3, label=f'k={best_k} (cotovelo)')
ax.set_xlabel('Número de Clusters (k)'); ax.set_ylabel('Inércia')
ax.legend(fontsize=11); ax.set_xticks(list(K_RANGE)); ax.grid(False)
ax = axes[2]
bars = ax.bar(K_RANGE, silhouettes, color=[CORES_CLUSTER[i % 4] for i in range(len(K_RANGE))],
              edgecolor='white', linewidth=0.6, width=0.6)
ax.axvline(best_k, color='#e74c3c', ls='--', lw=1.3, label=f'k={best_k} ({silhouettes[K_LIST.index(best_k)]:.3f})')
for bar, v in zip(bars, silhouettes):
    ax.text(bar.get_x()+bar.get_width()/2, v+0.004, f'{v:.3f}', ha='center', va='bottom', fontsize=10)
ax.set_xlabel('Número de Clusters (k)'); ax.set_ylabel('Coeficiente de Silhueta')
ax.legend(fontsize=11); ax.set_xticks(list(K_RANGE)); ax.grid(False)
plt.tight_layout(pad=1.2)
plt.savefig('fig1.png', bbox_inches='tight', dpi=180, facecolor='white')
plt.close()

fig, (ax_sc, ax_sil) = plt.subplots(1, 2, figsize=(13, 5.5))
for c in range(best_k):
    mask = labels_pt == c
    ax_sc.scatter(pt_pca[mask, 0], pt_pca[mask, 1], c=CORES_CLUSTER[c],
                  label=f"C{c+1} – n={mask.sum()}", s=70, alpha=0.85,
                  edgecolors='white', linewidths=0.5, zorder=3)
for c in range(best_k):
    ax_sc.scatter(centroids[c, 0], centroids[c, 1], marker='*', s=320, c=CORES_CLUSTER[c],
                  edgecolors='#2c3e50', linewidths=0.9, zorder=5)
    ax_sc.annotate(f'C{c+1}', (centroids[c, 0], centroids[c, 1]), fontsize=11, fontweight='bold',
                   xytext=(6, 4), textcoords='offset points', color=CORES_CLUSTER[c])
ax_sc.set_xlabel('PC1'); ax_sc.set_ylabel('PC2')
ax_sc.legend(loc='upper right', fontsize=10, framealpha=0.9); ax_sc.grid(False)
sil_v = silhouette_samples(pt_pca, labels_pt)
y_lo = 10
for c in range(best_k):
    sv = np.sort(sil_v[labels_pt == c])
    yu = y_lo + len(sv)
    ax_sil.fill_betweenx(np.arange(y_lo, yu), 0, sv, facecolor=CORES_CLUSTER[c], alpha=0.82)
    ax_sil.text(-0.10, (y_lo+yu)/2, f'C{c+1}', fontsize=11, color=CORES_CLUSTER[c], fontweight='bold', va='center')
    y_lo = yu + 6
avg_sil = float(np.mean(sil_v))
ax_sil.axvline(avg_sil, color='#e74c3c', ls='--', lw=1.5, label=f'Média: {avg_sil:.3f}')
ax_sil.set_xlabel('Coeficiente de Silhueta'); ax_sil.set_ylabel('Empresas por cluster')
ax_sil.legend(fontsize=11); ax_sil.grid(False)
plt.tight_layout(pad=1.2)
plt.savefig('fig2.png', bbox_inches='tight', dpi=180, facecolor='white')
plt.close()

fig, ax = plt.subplots(figsize=(13, 4.5))
dendrogram(Z_linkage, ax=ax, color_threshold=Z_linkage[-best_k+1, 2], leaf_rotation=90,
           leaf_font_size=4.5, above_threshold_color='#bdc3c7', count_sort='ascending')
ax.axhline(Z_linkage[-best_k+1, 2], color='#e74c3c', ls='--', lw=1.6, label=f'Corte → {best_k} clusters')
ax.set_xlabel('Startups Portuguesas'); ax.set_ylabel('Distância (Ward)')
ax.legend(fontsize=11); ax.grid(False)
plt.tight_layout(pad=1.2)
plt.savefig('fig3.png', bbox_inches='tight', dpi=180, facecolor='white')
plt.close()

c_m = pt.groupby('Cluster')[NUM_FEATURES].mean()
norm_ = MinMaxScaler()
c_n = pd.DataFrame(norm_.fit_transform(c_m), columns=NUM_FEATURES, index=c_m.index)
SHORT = ['Cap/HC', 'Int.\nHist.', 'Momentum', 'Deep\nTech', 'Analytics']
N = len(SHORT)
angles = [n / float(N) * 2 * np.pi for n in range(N)]; angles += angles[:1]
fig, axes4 = plt.subplots(1, best_k, figsize=(13, 4.2), subplot_kw=dict(polar=True))
for c in range(best_k):
    ax = axes4[c]
    vals = c_n.loc[c].values.tolist(); vals += vals[:1]
    ax.plot(angles, vals, 'o-', lw=2, color=CORES_CLUSTER[c], markersize=4)
    ax.fill(angles, vals, alpha=0.20, color=CORES_CLUSTER[c])
    ax.set_xticks(angles[:-1]); ax.set_xticklabels(SHORT, fontsize=9)
    ax.set_yticks([0.25, 0.5, 0.75]); ax.set_yticklabels(['25%', '50%', '75%'], fontsize=9, color='#7f8c8d')
    ax.set_ylim(0, 1)
    n_e = int((labels_pt == c).sum())
    label = NOMES[c].split('–')[1].strip()
    ax.set_title(f'C{c+1} – {label}\n(n={n_e})', fontsize=9, fontweight='bold', color=CORES_CLUSTER[c])
    ax.grid(False)
plt.tight_layout(pad=1.2)
plt.savefig('fig4.png', bbox_inches='tight', dpi=180, facecolor='white')
plt.close()

# ═════════════════════════════════════════════════════════
# PASSO 9 -- PROJEÇÃO E ADERÊNCIA DAS STARTUPS BRASILEIRAS
# ═════════════════════════════════════════════════════════
dist_br = cdist(br_pca, centroids, metric='euclidean')
br['Cluster_BR'] = dist_br.argmin(axis=1).astype(int)
br['Dist_Centroide'] = dist_br.min(axis=1)

pt_dists = cdist(pt_pca, centroids, metric='euclidean').min(axis=1)
THRESH = float(np.percentile(pt_dists, 75))
br['Alta_Aderencia'] = br['Dist_Centroide'] <= THRESH
print(f" -> Threshold P75 (PT): {THRESH:.3f}")
print(f" -> Distância média BR: {br['Dist_Centroide'].mean():.3f}")
print(f" -> BR alta aderência: {int(br['Alta_Aderencia'].sum())}/{len(br)}")
for c in range(best_k):
    mask = br['Cluster_BR'] == c
    alta = int(br.loc[mask, 'Alta_Aderencia'].sum())
    total = int(mask.sum())
    print(f"    {NOMES[c]}: {total} BR | {alta} alta aderência ({alta/max(total,1)*100:.1f}%)")

labels_br = br['Cluster_BR'].values.astype(int)

fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 5.5))
ax1.scatter(pt_pca[:, 0], pt_pca[:, 1], c='#d5d8dc', s=40, alpha=0.55,
            edgecolors='white', linewidths=0.3, label='Portugal (referência)', zorder=2)
for c in range(best_k):
    mask = labels_br == c
    ax1.scatter(br_pca[mask, 0], br_pca[mask, 1], c=CORES_CLUSTER[c], s=60, alpha=0.88,
                edgecolors='white', linewidths=0.4, label=f'C{c+1}', zorder=3)
for c in range(best_k):
    ax1.scatter(centroids[c, 0], centroids[c, 1], marker='*', s=280, c=CORES_CLUSTER[c],
                edgecolors='#2c3e50', linewidths=0.9, zorder=5)
ax1.set_xlabel('PC1'); ax1.set_ylabel('PC2')
ax1.legend(loc='upper right', fontsize=9, framealpha=0.9); ax1.grid(False)
x = np.arange(best_k); w = 0.38
al = [int(br.loc[br['Cluster_BR'] == c, 'Alta_Aderencia'].sum()) for c in range(best_k)]
bx = [int((br['Cluster_BR'] == c).sum()) - a for c, a in enumerate(al)]
b1 = ax2.bar(x - w/2, al, w, label='Alta Aderência', color=COR_BR, alpha=0.85, edgecolor='white')
b2 = ax2.bar(x + w/2, bx, w, label='Baixa Aderência', color='#aab7b8', alpha=0.85, edgecolor='white')
for bar in list(b1) + list(b2):
    h = bar.get_height()
    if h > 0:
        ax2.text(bar.get_x()+bar.get_width()/2, h+0.25, str(int(h)), ha='center', va='bottom', fontsize=10, fontweight='bold')
totais = [int((br['Cluster_BR'] == c).sum()) for c in range(best_k)]
ax2.set_xticks(x); ax2.set_xticklabels([f'C{c+1}\n({totais[c]} emp.)' for c in range(best_k)], fontsize=10)
ax2.set_ylabel('Empresas Brasileiras')
ax2.legend(fontsize=11); ax2.grid(False)
plt.tight_layout(pad=1.2)
plt.savefig('fig5.png', bbox_inches='tight', dpi=180, facecolor='white')
plt.close()

fig, ax_d = plt.subplots(figsize=(9, 5.2))
ptc = [int((labels_pt == c).sum()) for c in range(best_k)]
brc = [int((labels_br == c).sum()) for c in range(best_k)]
x = np.arange(best_k); w = 0.35
bp = ax_d.bar(x-w/2, ptc, w, label='Portugal', color=COR_PT, alpha=0.85, edgecolor='white')
bb = ax_d.bar(x+w/2, brc, w, label='Brasil', color=COR_BR, alpha=0.85, edgecolor='white')
for bar in list(bp) + list(bb):
    h = bar.get_height()
    ax_d.text(bar.get_x()+bar.get_width()/2, h+0.3, str(int(h)), ha='center', va='bottom', fontsize=11, fontweight='bold')
ax_d.set_xticks(x); ax_d.set_xticklabels([f'C{c+1}' for c in range(best_k)])
ax_d.set_ylabel('Número de Empresas')
ax_d.legend(); ax_d.grid(False)
plt.tight_layout(pad=1.2)
plt.savefig('fig6.png', bbox_inches='tight', dpi=180, facecolor='white')
plt.close()

# ═════════════════════════════════════════════════════════
# PASSO 10 -- LOADINGS E SENSIBILIDADE DO THRESHOLD
# ═════════════════════════════════════════════════════════
loadings = pd.DataFrame(pca.components_.T, columns=[f'PC{i+1}' for i in range(pca.n_components_)], index=NUM_FEATURES)l
print("\nLoadings:"); print(loadings.round(3))

percentis = [50, 75, 90]
resultados = []
for p in percentis:
    threshold = np.percentile(pt_dists, p)
    aderencia = br['Dist_Centroide'] <= threshold
    linha = {'Percentil': f'P{p}', 'Threshold': threshold, 'Aderência Geral (%)': aderencia.mean()*100}
    for c in range(best_k):
        mask_cluster = br['Cluster_BR'] == c
        linha[f'C{c+1} (%)'] = aderencia[mask_cluster].mean()*100 if mask_cluster.sum() > 0 else 0
    resultados.append(linha)
print("\nSensibilidade do threshold:")
