                color=CORES_CLUSTER[c], fontweight='bold', va='center')
    y_lo = yu + 6

avg_sil = float(np.mean(sil_v))
ax_sil.axvline(avg_sil, color='#e74c3c', ls='--', lw=1.5,
               label=f'Média: {avg_sil:.3f}')
ax_sil.set_xlabel('Coeficiente de Silhueta')
ax_sil.set_ylabel('Empresas por cluster')
ax_sil.set_title('(b) Silhueta por Empresa', fontweight='bold')
ax_sil.legend(fontsize=9); ax_sil.grid(True, alpha=0.2, ls='--', axis='x')
plt.tight_layout(pad=1.2)
plt.savefig('fig2.png', bbox_inches='tight', dpi=180, facecolor='white')
plt.close()
print("  → fig2.png")

# ── Figura 3: Dendrograma ────────────────────────────────────────────────
fig, ax = plt.subplots(figsize=(13, 4.5))
dendrogram(Z_linkage, ax=ax, color_threshold=Z_linkage[-best_k+1, 2],
           leaf_rotation=90, leaf_font_size=4.5,
