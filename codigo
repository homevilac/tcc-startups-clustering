np.random.seed(42)
ret = np.zeros(B)
for b in range(B):
    idx_boot = np.random.choice(n, size=n, replace=True)
    km_b = KMeans(n_clusters=best_k, n_init=10, random_state=b).fit(pt_pca[idx_boot])
    lp = km_b.predict(pt_pca)
    cont = np.zeros((best_k, best_k))
    for i_ in range(n):
        cont[lp[i_], original_labels[i_]] += 1
    ri, ci = linear_sum_assignment(-cont)
    mp = dict(zip(ri, ci))
    ret[b] = (np.array([mp[l] for l in lp]) == original_labels).mean()
