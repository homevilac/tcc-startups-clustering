# ═════════════════════════════════════════════════════════
# ADENDO 5 -- ESTATÍSTICA DE HOPKINS (TENDÊNCIA DE AGRUPAMENTO)
# ═════════════════════════════════════════════════════════
# H = soma(U) / (soma(U) + soma(W)), onde U = distância de pontos aleatórios
# uniformes até a empresa real mais próxima, e W = distância de empresas
# reais amostradas até sua vizinha real mais próxima (Lawson e Jurs, 1990).
# CONVENÇÃO: H próximo de 0,5 = sem tendência de agrupamento; H > 0,75 =
# tendência de agrupamento a 90% de confiança. Parte da literatura reporta
# a estatística complementar (1 - H, ex.: pacote R "clustertend"), com
# leitura invertida -- a fórmula abaixo segue Lawson e Jurs (1990) original.
from sklearn.neighbors import NearestNeighbors

def hopkins_statistic(X, sampling_size, rng):
    n, d = X.shape
    sample_idx = rng.choice(n, size=sampling_size, replace=False)
    X_sample = X[sample_idx]
    mins, maxs = X.min(axis=0), X.max(axis=0)
    X_random = rng.uniform(mins, maxs, size=(sampling_size, d))
    nn = NearestNeighbors(n_neighbors=2).fit(X)
    u = nn.kneighbors(X_random, n_neighbors=1)[0][:, 0]
    w = nn.kneighbors(X_sample, n_neighbors=2)[0][:, 1]  # exclui a própria empresa
    return u.sum() / (u.sum() + w.sum())

