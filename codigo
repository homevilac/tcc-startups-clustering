    ax_sc.annotate(f'C{c+1}', (centroids[c, 0], centroids[c, 1]),
                   fontsize=9, fontweight='bold', xytext=(6, 4),
                   textcoords='offset points', color=CORES_CLUSTER[c])
ax_sc.set_xlabel('PC1'); ax_sc.set_ylabel('PC2')
ax_sc.set_title('(a) Clusters – Startups Portuguesas', fontweight='bold')
ax_sc.legend(loc='upper right', fontsize=8, framealpha=0.9)
ax_sc.grid(True, alpha=0.2, ls='--')

sil_v = silhouette_samples(pt_pca, labels_pt)
y_lo  = 10
for c in range(best_k):
    sv  = np.sort(sil_v[labels_pt == c])
    yu  = y_lo + len(sv)
    ax_sil.fill_betweenx(np.arange(y_lo, yu), 0, sv,
