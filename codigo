# ── Instalar pacotes  ──────────────────────────────────────────────────────────────
import warnings
warnings.filterwarnings('ignore')

import numpy as np
import pandas as pd
import matplotlib
matplotlib.use('Agg')           # sem display; troque por 'TkAgg' para janela
import matplotlib.pyplot as plt

from sklearn.preprocessing import StandardScaler, MinMaxScaler
from sklearn.decomposition import PCA
from sklearn.cluster import KMeans, AgglomerativeClustering
from sklearn.metrics import silhouette_score, silhouette_samples
from scipy.cluster.hierarchy import dendrogram, linkage
from scipy.spatial.distance import cdist

np.random.seed(42)   # reprodutibilidade total

# ── Paleta de cores ──────────────────────────────────────────────────────────
COR_PT        = '#1a5276'
COR_BR        = '#c0392b'
CORES_CLUSTER = ['#2980b9', '#c0392b', '#27ae60', '#8e44ad', '#f39c12']

plt.rcParams.update({
    'font.family'   : 'DejaVu Sans',
    'font.size'     : 9,
    'axes.titlesize': 10,
    'axes.labelsize': 9,
    'figure.dpi'    : 180,
    'axes.spines.top'  : False,
    'axes.spines.right': False,
})


# ════════════════════════════════════════════════════════════════════════════
# PASSO 1 – CARGA E SEPARAÇÃO DOS DADOS
# ════════════════════════════════════════════════════════════════════════════


df = pd.read_excel('Dados MBA.xlsx',
                   sheet_name='Base Final')
print(df.shape)

# Corrige encoding do nome de coluna
df.columns = [c.replace('NegÃ³cio', 'Negócio') for c in df.columns]

# Separar subconjuntos por país
pt = df[df['País'] == 'Portugal'].copy().reset_index(drop=True)
br = df[df['País'] == 'Brasil'].copy().reset_index(drop=True)

print(f"  → Portugal : {len(pt)} startups")
print(f"  → Brasil   : {len(br)} startups")
print(f"  → Total    : {len(df)} startups\n")


# ════════════════════════════════════════════════════════════════════════════
# PASSO 2 – SELEÇÃO E ENGENHARIA DE FEATURES
# ════════════════════════════════════════════════════════════════════════════
print("=" * 72)
print("PASSO 2 – Engenharia de variáveis derivadas")
print("=" * 72)

# Features numéricas conforme projeto de pesquisa
NUM_FEATURES = [
    'Captação per HC',                                            # Cap/HC
    'Intensidade Histórica (Total Captado/Anos de fundação)',     # Int. Hist.
    'Momentum (%ult aporte/total captado)',                       # Momentum
    'Score Deeptech',                                             # Deeptech
    'Score Analytics',                                            # Analytics
]

# Feature categórica
CAT_FEATURE = 'Modelo de Negócio'

# Imputação de nulos pela mediana do subconjunto de cada país
pt[NUM_FEATURES] = pt[NUM_FEATURES].fillna(pt[NUM_FEATURES].median())
br[NUM_FEATURES] = br[NUM_FEATURES].fillna(br[NUM_FEATURES].median())
pt[CAT_FEATURE]  = pt[CAT_FEATURE].fillna('Unknown')
br[CAT_FEATURE]  = br[CAT_FEATURE].fillna('Unknown')

# One-Hot Encoding (proxy de ACM) – fit somente em PT, aplicar em BR
pt_cat = pd.get_dummies(pt[CAT_FEATURE], prefix='Neg')
br_cat = pd.get_dummies(br[CAT_FEATURE], prefix='Neg')

# Para que BR tenha exatamente as mesmas colunas que PT
for col in pt_cat.columns:
    if col not in br_cat.columns:
        br_cat[col] = 0
br_cat = br_cat[pt_cat.columns]  # reordenar

# Matrizes completas de features
pt_full = pd.concat(
    [pt[NUM_FEATURES].reset_index(drop=True),
     pt_cat.reset_index(drop=True)], axis=1
)
br_full = pd.concat(
    [br[NUM_FEATURES].reset_index(drop=True),
     br_cat.reset_index(drop=True)], axis=1
)

print(f"  → Features numéricas : {NUM_FEATURES}")
print(f"  → Dummies (OHE)      : {pt_cat.columns.tolist()}")
print(f"  → Total de features  : {pt_full.shape[1]}\n")


# ════════════════════════════════════════════════════════════════════════════
# PASSO 3 – PADRONIZAÇÃO Z-SCORE
# ════════════════════════════════════════════════════════════════════════════

scaler    = StandardScaler()
pt_scaled = scaler.fit_transform(pt_full)   # fit + transform em PT
br_scaled = scaler.transform(br_full)       # apenas transform em BR

print(f"  → PT padronizado: shape {pt_scaled.shape}")
print(f"  → BR padronizado: shape {br_scaled.shape}\n")


# ════════════════════════════════════════════════════════════════════════════
# PASSO 4 – ANÁLISE DE COMPONENTES PRINCIPAIS (PCA)
#   Fit em PT, retenção dos componentes com variância acumulada ≥ 80%,
#   e projeção de BR no mesmo espaço.
# ════════════════════════════════════════════════════════════════════════════


# Diagnóstico: PCA completo para calcular variância acumulada
pca_diag  = PCA(n_components=None, random_state=42)
pca_diag.fit(pt_scaled)
var_cumul = np.cumsum(pca_diag.explained_variance_ratio_)
n_comp    = int(np.argmax(var_cumul >= 0.80) + 1)

# PCA final com n_comp componentes
pca    = PCA(n_components=n_comp, random_state=42)
pt_pca = pca.fit_transform(pt_scaled)   # fit + transform em PT
br_pca = pca.transform(br_scaled)      # apenas transform em BR

print(f"  → Componentes selecionados : {n_comp}")
print(f"  → Variância acumulada      : {var_cumul[n_comp-1]*100:.1f}%")
for i, ev in enumerate(pca.explained_variance_ratio_):
    print(f"     PC{i+1}: {ev*100:.1f}%")
print()


# ════════════════════════════════════════════════════════════════════════════
# PASSO 5 – DETERMINAÇÃO DO K ÓTIMO (Elbow + Silhueta)
# ════════════════════════════════════════════════════════════════════════════
print("=" * 72)
print("PASSO 5 – Determinação do k ótimo")
print("=" * 72)

inertias    = []
silhouettes = []
K_RANGE     = range(2, 9)

for k in K_RANGE:
    km  = KMeans(n_clusters=k, random_state=42, n_init=10)
    lbl = km.fit_predict(pt_pca)
    inertias.append(km.inertia_)
    silhouettes.append(float(silhouette_score(pt_pca, lbl)))
    print(f"  k={k} | Inércia={km.inertia_:>12.1f} | Silhueta={silhouettes[-1]:.4f}")

best_k = int(list(K_RANGE)[int(np.argmax(silhouettes))])
print(f"\n  → k ótimo: {best_k}  (Silhueta = {max(silhouettes):.4f})\n")


# ════════════════════════════════════════════════════════════════════════════
# PASSO 6 – K-MEANS FINAL (aplicado somente em PT)
# ════════════════════════════════════════════════════════════════════════════
print("=" * 72)
print(f"PASSO 6 – K-Means final  (k = {best_k})")
print("=" * 72)

km_final  = KMeans(n_clusters=best_k, random_state=42, n_init=20)
pt['Cluster'] = km_final.fit_predict(pt_pca)
centroids = km_final.cluster_centers_

# Nomear clusters automaticamente pelas características dos centróides
cstats  = pt.groupby('Cluster')[NUM_FEATURES].mean()
mn_int  = float(cstats['Intensidade Histórica (Total Captado/Anos de fundação)'].mean())
mn_cap  = float(cstats['Captação per HC'].mean())

NOMES = {}
for c in range(best_k):
    row = cstats.loc[c]
    if float(row['Score Deeptech']) >= 1 and float(row['Captação per HC']) > mn_cap:
        nome = f"C{c+1} – DeepTech Intensivo"
    elif float(row['Momentum (%ult aporte/total captado)']) >= 0.9:
        nome = f"C{c+1} – Early Stage Concentrado"
    elif float(row['Intensidade Histórica (Total Captado/Anos de fundação)']) > mn_int * 1.5:
        nome = f"C{c+1} – Crescimento Acelerado"
    elif float(row['Score Analytics']) >= 1:
        nome = f"C{c+1} – SaaS Analytics"
    else:
        nome = f"C{c+1} – Base Ampla"
    NOMES[c] = nome

for c, n in NOMES.items():
    print(f"  {n} : {int((pt['Cluster']==c).sum())} empresas PT")
print()

tabela2 = cstats.round(0).copy()
tabela2['Cluster_Nome'] = tabela2.index.map(NOMES)
tabela2['Mod_Neg_Predominante'] = pt.groupby('Cluster')['Modelo de Negócio']\
                                    .agg(lambda x: x.value_counts().index[0])
tabela2.to_csv(os.path.join(PASTA, 'tabela2_clusters.csv'),
               encoding='utf-8-sig')
# ════════════════════════════════════════════════════════════════════════════
# PASSO 7 – CLUSTERING HIERÁRQUICO (validação – Ward linkage)
# ════════════════════════════════════════════════════════════════════════════
print("=" * 72)
print("PASSO 7 – Clustering Hierárquico (validação)")
print("=" * 72)

Z_linkage   = linkage(pt_pca, method='ward')
hier_labels = AgglomerativeClustering(
    n_clusters=best_k, linkage='ward'
).fit_predict(pt_pca)

# Concordância: busca a melhor permutação de rótulos
from itertools import permutations
best_acc = 0.0
for perm in permutations(range(best_k)):
    mapped  = np.array([perm[l] for l in hier_labels])
    acc     = float(np.mean(mapped == pt['Cluster'].values))
    best_acc = max(best_acc, acc)

print(f"  → Concordância K-Means × Hierárquico: {best_acc*100:.1f}%\n")

# ════════════════════════════════════════════════════════════════════════════
# PASSO 8 – GERAÇÃO DOS GRÁFICOS DA FORMAÇÂO DOS CLUSTER PT
# ════════════════════════════════════════════════════════════════════════════
labels_pt = pt['Cluster'].values.astype(int)

# ── Figura 1: PCA + Elbow + Silhueta ─────────────────────────────────────
fig, axes = plt.subplots(1, 3, figsize=(14, 4.2))

ax = axes[0]
ax.plot(range(1, len(var_cumul)+1), var_cumul*100, 'o-', color=COR_PT, lw=2, markersize=5)
ax.axhline(80, color='#e74c3c', ls='--', lw=1.2, label='Limiar 80%')
ax.axvline(n_comp, color='#7f8c8d', ls=':', lw=1.3)
ax.fill_between(range(1, n_comp+1), var_cumul[:n_comp]*100, alpha=0.12, color=COR_PT)
ax.set_xlabel('Componentes'); ax.set_ylabel('Variância Acumulada (%)')
ax.set_title('(a) Variância Acumulada – PCA', fontweight='bold')
ax.legend(fontsize=8); ax.set_xlim(0.5, len(var_cumul)+0.5); ax.set_ylim(0, 105)
ax.grid(True, alpha=0.25, ls='--')

ax = axes[1]
ax.plot(K_RANGE, inertias, 'o-', color=COR_PT, lw=2, markersize=5)
ax.axvline(best_k, color='#e74c3c', ls='--', lw=1.3, label=f'k={best_k}')
ax.set_xlabel('Número de Clusters (k)'); ax.set_ylabel('Inércia')
ax.set_title('(b) Método Elbow', fontweight='bold')
ax.legend(fontsize=8); ax.set_xticks(list(K_RANGE)); ax.grid(True, alpha=0.25, ls='--')

ax = axes[2]
bars = ax.bar(K_RANGE, silhouettes,
              color=[CORES_CLUSTER[i % 5] for i in range(len(K_RANGE))],
              edgecolor='white', linewidth=0.6, width=0.6)
ax.axvline(best_k, color='#e74c3c', ls='--', lw=1.3,
           label=f'k={best_k} ({max(silhouettes):.3f})')
for bar, v in zip(bars, silhouettes):
    ax.text(bar.get_x()+bar.get_width()/2, v+0.004, f'{v:.3f}',
            ha='center', va='bottom', fontsize=7)
ax.set_xlabel('Número de Clusters (k)'); ax.set_ylabel('Coeficiente de Silhueta')
ax.set_title('(c) Silhueta por k', fontweight='bold')
ax.legend(fontsize=8); ax.set_xticks(list(K_RANGE)); ax.set_ylim(0, 0.68)
ax.grid(True, alpha=0.25, ls='--', axis='y')
plt.tight_layout(pad=1.2)
plt.savefig('fig1.png', bbox_inches='tight', dpi=180, facecolor='white')
plt.close()
print("  → fig1.png")

# ── Figura 2: Scatter clusters PT + Silhueta por amostra ─────────────────
fig, (ax_sc, ax_sil) = plt.subplots(1, 2, figsize=(13, 5.5))

for c in range(best_k):
    mask = labels_pt == c
    ax_sc.scatter(pt_pca[mask, 0], pt_pca[mask, 1],
                  c=CORES_CLUSTER[c], label=f"C{c+1} – n={mask.sum()}",
